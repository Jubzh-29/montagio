# Pinned versions for the GPU session tooling, sourced by bootstrap.sh.
# Checked on 2026-10-17 against GitHub, PyPI, download.pytorch.org and nodejs.org.

# ComfyUI (GPL-3.0): the tag is cloned, then its commit is verified.
COMFYUI_REPO=https://github.com/Comfy-Org/ComfyUI.git
COMFYUI_TAG=v0.41.0
COMFYUI_COMMIT=98cc0bf84b7cb1383654c5b402e7612d875d6d22

# The lowest Pillow in ComfyUI's environment (2026-10-26): the PyTorch index installs Pillow 12.3.0 with torchvision,
# which a crafted PNG sent to LoadImage can stall (GHSA-5xm2-6676-qcp9, GHSA-g4qv-2jxx-769h; 13.0.0 fixes them).
# Pillow 13 needs Python 3.11 or newer, which the installer and the bootstrap require (3.10 is out of support since 2026-10-01).
PILLOW_MIN=13.0.0

# comfy-api-proxy (MIT): Comfy API v2 in front of the local ComfyUI, PyPI release.
COMFY_API_PROXY_VERSION=0.1.6

# PyTorch for ComfyUI. ComfyUI v0.41.0 asks for a CUDA 13.0 build on RTX 20 series
# and newer (needs an NVIDIA driver that reports "CUDA Version: 13.0" or higher).
TORCH_VERSION=2.14.1
TORCHVISION_VERSION=0.29.1
TORCH_CUDA=cu130
# Fallback for hosts whose driver stops at CUDA 12.8 (last torch release built for cu128).
TORCH_FALLBACK_VERSION=2.11.0
TORCHVISION_FALLBACK_VERSION=0.26.0
TORCH_FALLBACK_CUDA=cu128

# Node.js 22 LTS for the SDK smoke test and the weight downloader (linux-x64.tar.gz, checksum from SHASUMS256.txt).
# 22.23.4: the security release of 2026-10-20 (Brotli, DNS, TLS).
NODE_VERSION=22.23.4
NODE_SHA256=b8492284c76a54baf58d61668dd0e41ee0fc98adabf9503d30f05d08f55b4406

# The voice of the avatar extension (2026-10-19): ComfyUI v0.41.0 has no local text-to-speech node.
# wildminder/ComfyUI-Chatterbox (Apache-2.0, its vendored chatterbox code MIT) at a pinned commit, patched by
# patches/comfyui-chatterbox-no-routes.patch (its /chatterbox/* HTTP routes take any absolute path), its Python
# packages from requirements-chatterbox.txt. The GPU pod and infra/local install it (infra/local when the avatar is asked for).
CHATTERBOX_NODE_REPO=https://github.com/wildminder/ComfyUI-Chatterbox.git
CHATTERBOX_NODE_COMMIT=4597af8f59d4460d441e13533eae24b092e40952

# The object swap's tracker (2026-10-24): ComfyUI v0.41.0 has no node that follows an object through a video.
# kijai/ComfyUI-segment-anything-2 (Apache-2.0, Meta's SAM 2 code vendored) at a pinned commit, unpatched: it
# opens no HTTP route and starts no process, and needs no Python package ComfyUI lacks (PyYAML, torch, numpy;
# its OpenCV, decord and pycocotools imports sit in functions the swap never calls). Its one download, of a
# missing weight, never runs: the lock puts sam2.1_hiera_base_plus-fp16.safetensors in models/sam2 first.
SAM2_NODE_REPO=https://github.com/kijai/ComfyUI-segment-anything-2.git
SAM2_NODE_COMMIT=0c35fff5f382803e2310103357b5e985f5437f32

# yt-dlp (Unlicense) for the remix's import by link (2026-10-25): the release's standalone binary for each system
# (yt-dlp.exe, yt-dlp_linux), checked against the release's SHA2-256SUMS. infra/local puts it in <install>/tools and
# hands it to the app as MONTAGIO_YTDLP; the GPU pod never imports a link.
YTDLP_VERSION=2026.10.21
YTDLP_SHA256_WINDOWS=33121d192d706e62f684a06f80918e3f3a8ba52ac3a65213b6951c39c7d9f555
YTDLP_SHA256_LINUX=d8bd33fca9d5b23bd5b9952b3fca36db5c46331933fda9f598a3da14ce2c243f
