{
  "name": "montagio",
  "version": "0.1.0",
  "private": true,
  "description": "Open camera-motion preset studio on open-weights models, built on ComfyUI.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "infra/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:nodes": "python -m pytest comfy-nodes -q",
    "test:modal": "python -m pytest infra/modal -q",
    "previews:posters": "tsx apps/web/scripts/preview-posters.mts",
    "check:open-stack": "tsx tools/check-open-stack/src/cli.ts . --out apps/web/public/open-stack-report.json",
    "montagio": "tsx packages/presets/src/montagio.ts",
    "showcase": "tsx packages/showcase/src/showcase.ts",
    "mcp": "tsx packages/mcp/src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
